{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx convex deploy --cmd 'npm run build'",
  "rewrites": [
    { "source": "/open/share", "destination": "/" },
    { "source": "/open", "destination": "/" },
    { "source": "/share/:id", "destination": "/api/share?id=:id" }
  ]
}
